# ==============================================================================
# Dockge Stack Environment Variables Template
# Copy these values into Dockge's .env configuration tab
# ==============================================================================

# 1. Existing Cloudflare Tunnel Network Name in Docker
# (Run 'docker network ls' on your Homelab server to check your existing tunnel network name)
HOMELAB_TUNNEL_NETWORK=homelab-network

# 2. Local LAN Port (Optional - only needed if you uncomment 'ports' in compose.yaml)
LOCAL_WEB_PORT=8080

# 3. External Financial API Keys
SEC_API_KEY=
GEMINI_API_KEY=

# 4. Sentry Application Observability (Milestone 5.1)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# 5. Autonomous Daily NAV Scheduler (Milestone 5.3)
DAILY_NAV_SYNC_ENABLED=true
DAILY_NAV_SYNC_HOUR=20
DAILY_NAV_SYNC_MINUTE=30

# 6. Default Statement Decryption Password (Optional Fallback)
STATEMENT_DEFAULT_PASSWORD=
