# ==============================================================================
# Dockge Stack Environment Variables Template
# Copy these values into Dockge's .env configuration tab
# ==============================================================================

# 1. Local Homelab Port (Default: 8095)
LOCAL_WEB_PORT=8095

# 2. External Financial API Keys
SEC_API_KEY=
GEMINI_API_KEY=

# 3. Sentry Application Observability (Milestone 5.1)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# 4. Autonomous Daily NAV Scheduler (Milestone 5.3)
DAILY_NAV_SYNC_ENABLED=true
DAILY_NAV_SYNC_HOUR=20
DAILY_NAV_SYNC_MINUTE=30

# 5. Default Statement Decryption Password (Optional Fallback)
STATEMENT_DEFAULT_PASSWORD=
