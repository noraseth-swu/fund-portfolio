# SEC Open API Subscription Key
SEC_API_KEY=your_sec_subscription_key_here

# Google Gemini API Key (For fallback PDF statement parser)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
SERVER_PORT=8088
DATABASE_URL=sqlite:portfolio.db

# Sentry Observability (Optional - GitHub Student Developer Pack)
SENTRY_DSN="https://your_sentry_dsn_here"
SENTRY_ENVIRONMENT="production"

